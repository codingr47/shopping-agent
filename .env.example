# OpenAI API configuration
OPENAI_API_KEY=sk-...

# Model tier configuration (placeholder identifiers from spec, used literally)
NANO_MODEL=gpt-5.4-nano
MINI_MODEL=gpt-5.4-mini

# Backend server
PORT=3001
SQLITE_PATH=./data/app.db

# MCP server spawn configuration
MCP_SERVER_CMD=npx
MCP_SERVER_ARGS=tsx,../mcp-server/src/index.ts

# Frontend
VITE_SERVER_URL=http://localhost:3001
